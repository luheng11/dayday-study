# ============ DeepSeek（必填：AI 出题与报告） ============
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ============ Mock 模式 ============
# true：使用内置题库演示完整闭环（无需 Key，适合首次联调）
# false：调用 DeepSeek 真实出题（需上面的 DEEPSEEK_API_KEY）
LLM_MOCK=false

# ============ 应用 ============
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# ============ 日志 ============
LOG_LEVEL=INFO

# ============ 用户系统（JWT / 微信登录 / MySQL） ============
# 生产环境务必换成强随机密钥
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=43200

# 微信小程序：填入真实 AppID/AppSecret 并把 WECHAT_MOCK_LOGIN 改为 false 后走真实登录
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# true（默认）：未配置凭据时用固定开发 openid 完成本地联调
WECHAT_MOCK_LOGIN=true

# MySQL（docker 启动：docker run -d --name chuangguan-mysql -e TZ=Asia/Shanghai \
#   -e MYSQL_ROOT_PASSWORD=123456 -p 3306:3306 mysql:8）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=chuangguan_xuetang
MYSQL_CHARSET=utf8mb4
MYSQL_POOL_MINSIZE=1
MYSQL_POOL_MAXSIZE=10
# true：启动时自动建库建表（连不上 MySQL 也不阻断启动，匿名模式仍可用）
MYSQL_AUTO_INIT=true
